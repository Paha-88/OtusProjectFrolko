@startuml

skinparam defaultFontName "Microsoft YaHei"
hide circle
skinparam linetype ortho
skinparam nodesep 10
skinparam ranksep 10

title ER-диаграмма

together { 
enum "СтатусыСертификатов (перечисление)" as EnumStatus {
  Выпущен
  Активирован
  ЧастичноСписан
  Погашен
  Аннулирован
}

' ===== Справочники =====

entity "НоминалыСертификатов (справочник)" as Nominal {
  Код : Строка(9)
  Наименование : Строка(25)
  Сумма : Число(15,2)
  Активен : Булево
}

entity "Сертификаты (справочник)" as Cert {
  Код : Строка(9)
  Наименование : Строка(25)
  Номинал : СправочникСсылка.ФПВ_НоминалыСертификатов
  ДатаВыпуска : Дата
  ДатаАктивации : Дата
  СрокДействия : Дата
}
}
' ===== Документы =====
together { 
entity "ГенерацияСертификатов (документ)" as DocGen {
  Номер : Строка(9)
  Дата : Дата
  Номинал : СправочникСсылка.ФПВ_НоминалыСертификатов
  Количество : Число(10,0)
  UUIDЗапроса : Строка(36)
  СрокДействия : Дата
  Комментарий : Строка(500)
}

entity "ГенерацияСертификатов.Сертификаты (табличная часть)" as DocGenTS {
  Номер : Строка(50)
  Сертификат : СправочникСсылка.ФПВ_Сертификаты
}

entity "ПродажаСертификата(документ)" as DocSale {
  Номер : Строка(9)
  Дата : Дата
  Сертификат : СправочникСсылка.ФПВ_Сертификаты
  СуммаПродажи : Число(15,2)
  Покупатель : СправочникСсылка._ДемоКонтрагенты
}

entity "СписаниеСертификата (документ)" as DocWriteOff {
  Номер : Строка(9)
  Дата : Дата
  Сертификат : СправочникСсылка.ФПВ_Сертификаты
  СуммаСписания : Число(15,2)
  ПолноеСписание : Булево
}

entity "АннулированиеСертификата (документ)" as DocCancel {
  Номер : Строка(9)
  Дата : Дата
  Сертификат : СправочникСсылка.ФПВ_Сертификаты
}
}

' ===== Регистры =====
together {
entity "ОстаткиСертификатов (регистр накопления)" as RegBalance {
  Период : Дата
  Регистратор : ДокументСсылка
  Сертификат : СправочникСсылка.ФПВ_Сертификаты
  Сумма : Число(15,2)
}

entity "СтатусыСертификатов(регистр сведений)" as RegStatus {
  Период : Дата
  Регистратор : ДокументСсылка
  Сертификат : СправочникСсылка.ФПВ_Сертификаты
  Статус : ПеречислениеСсылка.ФПВ_СтатусыСертификатов
  Остаток : Число(15,2)
  ДатаИзменения : Дата 
}
}

' ===== Связи (ссылочные) =====
Cert }o--|| Nominal : "Номинал"
DocGen }o--|| Nominal : "Номинал"
DocGen ||--o{ DocGenTS : "ТЧ Сертификаты"
DocGenTS }o--|| Cert : "Сертификат"
DocSale }o--|| Cert : "Сертификат"
DocWriteOff }o--|| Cert : "Сертификат"
DocCancel }o--|| Cert : "Сертификат"

' ===== Связи регистров (измерения → справочник) =====
RegBalance }o--|| Cert : "Сертификат"
RegStatus }o--|| Cert : "Сертификат"
RegStatus }o--|| EnumStatus : "Статус"
}

@enduml