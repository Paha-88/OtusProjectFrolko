				.Установить("Дата", ТекущаяДата()-1)
			    .Установить("Сертификат", СтрСертификат.Сертификат)
				.Установить("СуммаПродажи", Номинал.Сумма)
				.Фикция("Покупатель")  
				.Записать();					
			
		    МассивДокументов.Добавить(Документ);	
			
		КонецЦикла;		
    
	КонецЦикла;
	
    Возврат МассивДокументов;
