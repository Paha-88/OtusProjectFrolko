#Область ПодготовкаДанных

Функция СоздатьТестовыеДокументы(КоличествоДокументов) Экспорт
	
	СтруктураДанных = Новый Структура;	
	МассивДокументов = Новый Массив;
		
	Номинал = ЮТест.Данные().КонструкторОбъекта("Справочники.ФПВ_НоминалыСертификатов")
    	.Установить("Наименование","5999")
		.Установить("Сумма",5999)
		.Установить("Активен",Истина)
		.Записать();
	СтруктураДанных.Вставить("Номинал", Номинал); 
	
	Сертификат1 = ЮТест.Данные().КонструкторОбъекта("Справочники.ФПВ_Сертификаты")
    	.Установить("Наименование","ТестовыйСертификат1")
		.Установить("Номинал",Номинал)
		.Установить("ДатаВыпуска",ТекущаяДата())
		.Установить("СрокДействия",КонецГода(ТекущаяДата()))
		.Записать();
		
	Сертификат2 = ЮТест.Данные().КонструкторОбъекта("Справочники.ФПВ_Сертификаты")
    	.Установить("Наименование","ТестовыйСертификат2")
		.Установить("Номинал",Номинал)
		.Установить("ДатаВыпуска",ТекущаяДата())
		.Установить("СрокДействия",КонецГода(ТекущаяДата()))
		.Записать();	
	
	Документ = ЮТест.Данные().КонструкторОбъекта("Документы.ФПВ_ГенерацияСертификатов")  
		.Установить("Дата", НачалоДня(ТекущаяДата()))
	    .Установить("Номинал", Номинал)
		.Установить("Количество", КоличествоДокументов)
		.Установить("СрокДействия", КонецГода(ТекущаяДата()))
	    .ТабличнаяЧасть("Сертификаты")
		        .ДобавитьСтроку()
		        .Установить("Сертификат", Сертификат1)
				.ДобавитьСтроку()
				.Установить("Сертификат", Сертификат2)  
		.Записать();					
	
    МассивДокументов.Добавить(Документ);
    
	СтруктураДанных.Вставить("МассивДокументов", МассивДокументов);
	
    Возврат СтруктураДанных;
КонецФункции

Функция СоздатьТестовыеДокументыПродажа(МассивДокументовГенерация) Экспорт
		
	МассивДокументов = Новый Массив;
	
	Для Каждого Стр Из МассивДокументовГенерация Цикл
	
		Номинал = Стр.Номинал; 
		
		Для Каждого СтрСертификат ИЗ Стр.Сертификаты Цикл 
			
