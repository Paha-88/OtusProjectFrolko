		.ДобавитьТест("ОстаткиПоРегистрамНольГенерацияСертификатовНегатив", "Остатки сертификатов -", "Негатив")
		.ДобавитьТест("АннулированиеСертификатов", "Аннулирование сертификатов", "Позитив")		
	;

КонецПроцедуры

Процедура СозданиеДокументовГенерацияСертификатов() Экспорт   
	
	// 1. Подготовка параметров и генерация данных для выполнения функции.
	СтруктураДанных = СоздатьТестовыеДокументы(2); 
	МассивДокументов = СтруктураДанных.МассивДокументов; 
	
	// 2. Выполнение функции.
	
	
	// 3. Проверка результата.
	ЮТест.ОжидаетЧто(МассивДокументов.Количество(), "Количество созданных документов")
        .Больше(0);		
		
    Для Каждого Ссылка Из МассивДокументов Цикл
        ЮТест.ОжидаетЧто(Ссылка.Пустая(), "Документ не пустой")
            .ЭтоЛожь();
	КонецЦикла;    
		
КонецПроцедуры	

Процедура ПроведениеИДвиженияДокументовГенерацияСертификатов() Экспорт
	
	// 1. Подготовка параметров и генерация данных для выполнения функции.
