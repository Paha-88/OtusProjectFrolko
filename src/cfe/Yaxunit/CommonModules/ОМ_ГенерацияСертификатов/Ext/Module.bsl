		ОписаниеЗапроса.ВыбираемыеПоля.Добавить("Статус");
		ОписаниеЗапроса.Условия.Добавить("Регистратор = &Регистратор");
		ОписаниеЗапроса.ЗначенияПараметров.Вставить("Регистратор", Ссылка);
		РезультатТоварныеЗапасы = ЮТЗапросы.РезультатЗапроса(ОписаниеЗапроса);
        
        ЮТест.ОжидаетЧто(РезультатТоварныеЗапасы.Количество()>0, "Есть движения по регистру сведений СтатусыСертификатов")
