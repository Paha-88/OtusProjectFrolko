
Процедура ОбработкаПроведения(Отказ, Режим)
	
	ДанныеСертификата = ФПВ_Сертификаты.ПолучитьДанныеСертификата(Сертификат,,Ссылка);
	Если ДанныеСертификата = Неопределено Тогда
		Отказ = Истина;
		Сообщить("Данный сертификат не выпущен");
		Возврат;
	КонецЕсли;
	
	СуммаОстаток = ДанныеСертификата.СуммаОстаток - СуммаСписания; 
	Если СуммаОстаток < 0 Тогда
		Отказ = Истина;
		Сообщить("Не возможно списать сертификат, остаток меньше суммы списания");
		Возврат;
	КонецЕсли;
	
	Если СуммаОстаток = 0 Тогда
		СтатусСертификата = Перечисления.ФПВ_СтатусыСертификатов.Погашен;
	Иначе
		СтатусСертификата = Перечисления.ФПВ_СтатусыСертификатов.ЧастичноСписан;
	КонецЕсли;	
	
	// регистр ФПВ_СтатусыСертификатов
	Движения.ФПВ_СтатусыСертификатов.Записывать = Истина;
	Движение = Движения.ФПВ_СтатусыСертификатов.Добавить();
	Движение.Период 		= Дата;
	Движение.Сертификат 	= Сертификат;
	Движение.Статус 		= СтатусСертификата;
	Движение.Остаток 		= СуммаОстаток;
	Движение.ДатаИзменения 	= ТекущаяДата();

	// регистр ФПВ_ОстаткиСертификатов Расход
	Движения.ФПВ_ОстаткиСертификатов.Записывать = Истина;
	Движение = Движения.ФПВ_ОстаткиСертификатов.Добавить();
	Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
	Движение.Период 		= Дата;
	Движение.Сертификат 	= Сертификат;
	Движение.Сумма 			= СуммаСписания;

КонецПроцедуры
