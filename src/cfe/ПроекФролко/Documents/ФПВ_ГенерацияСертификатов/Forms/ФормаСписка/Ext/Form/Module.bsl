
&НаКлиенте
Процедура ПолучитьЗапросыНаГенерациюСертификатов(Команда)
	ПолучитьЗапросыНаГенерациюСертификатовНаСервере();
КонецПроцедуры 

&НаСервере
Процедура ПолучитьЗапросыНаГенерациюСертификатовНаСервере()
	СтрокаJSON = "";
	RMQ_Очередь = Справочники.ФПВ_RMQ_Очередь.НайтиПоНаименованию("Запрос на создание сертификатов");
	ФПВ_Сертификаты.ПрочитатьСообщениеСервер(RMQ_Очередь, СтрокаJSON);
	
	Если ЗначениеЗаполнено(СтрокаJSON) Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);

		ДанныеСтруктура = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		НовыйДокумент = Документы.ФПВ_ГенерацияСертификатов.СоздатьДокумент();
		НовыйДокумент.UUIDЗапроса 	= ДанныеСтруктура.UUIDЗапроса;
		НовыйДокумент.Дата 			= ПреобразоватьДату(ДанныеСтруктура.Дата);
		НовыйДокумент.Количество 	= ДанныеСтруктура.Количество;
		НовыйДокумент.СрокДействия 	= ПреобразоватьДату(ДанныеСтруктура.СрокДействия);
		НовыйДокумент.Номинал 		= Справочники.ФПВ_НоминалыСертификатов.НайтиПоРеквизиту("Сумма",ДанныеСтруктура.НоминалСумма);
		
		НовыйДокумент.Записать(РежимЗаписиДокумента.Запись); 
		Сообщить("Создан документ "+НовыйДокумент.Ссылка);
	КонецЕсли;	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПреобразоватьДату(ДатаСтрокой)
	
	Если Не ЗначениеЗаполнено(ДатаСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;	
	
	ДатаСтрокой = СтрЗаменить(ДатаСтрокой,"-","");	
	ДатаСтрокой = Лев(ДатаСтрокой,8);
	Дата1С = Дата(ДатаСтрокой);
	
	Возврат Дата1С;
	
КонецФункции	

&НаКлиенте
Процедура ПолучитьСформированныеСертификаты(Команда)
	ПолучитьСформированныеСертификатыНаСервере();
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ПолучитьСформированныеСертификатыНаСервере()
	СтрокаJSON = "";
	RMQ_Очередь = Справочники.ФПВ_RMQ_Очередь.НайтиПоНаименованию("Список созданных сертификатов");
	ФПВ_Сертификаты.ПрочитатьСообщениеСервер(RMQ_Очередь, СтрокаJSON);
	
	Если ЗначениеЗаполнено(СтрокаJSON) Тогда
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);

		ДанныеСтруктура = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		ДокументСсылка = Документы.ФПВ_ГенерацияСертификатов.НайтиПоРеквизиту("UUIDЗапроса",ДанныеСтруктура.UUIDЗапроса);
		ДокументОбъект = ДокументСсылка.ПолучитьОбъект(); 
		
		Если ЗначениеЗаполнено(ДокументСсылка) Тогда
			Для Каждого Стр Из ДанныеСтруктура.МассивСертификатов Цикл
				НовыйСертификат = Справочники.ФПВ_Сертификаты.СоздатьЭлемент(); 
				НовыйСертификат.Наименование = Стр.Наименование;
				НовыйСертификат.ДатаВыпуска = ПреобразоватьДату(Стр.ДатаВыпуска); 
				НовыйСертификат.СрокДействия = ПреобразоватьДату(ДанныеСтруктура.СрокДействия);

			    НовыйСертификат.Записать();
				
				НовСтрДок = ДокументОбъект.Сертификаты.Добавить();
				НовСТрДок.Номер = Стр.Наименование;
				НовСтрДок.Сертификат = НовыйСертификат.Ссылка;				
			КонецЦикла;	                                      		
		КонецЕсли;
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);  
		
		Сообщить("Обработан документ "+ДокументОбъект.Ссылка);
		
	КонецЕсли;
КонецПроцедуры


