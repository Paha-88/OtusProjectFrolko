 
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Если НЕ (РольДоступна("ФПВ_Администрирование") ИЛИ РольДоступна("Администратор")) Тогда
		Элементы.ГенерацияСертификатов.Доступность = Ложь;
	КонецЕсли;	
КонецПроцедуры 
 
&НаКлиенте
Процедура ГенерацияСертификатов(Команда)
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли;	
	
	Если Объект.Сертификаты.Количество() > 0 Тогда
		Сообщить("Табличная часть не пуста. Генерация новых сертификатов не возможна");
		Возврат;
	КонецЕсли;	
	
	СоздатьСертификаты();
	
КонецПроцедуры  

&НаСервере
Процедура СоздатьСертификаты()
	Сч=1;
	Пока Сч<=Объект.Количество Цикл
		НовыйСертификат = Справочники.ФПВ_Сертификаты.СоздатьЭлемент();
		НовыйСертификат.Номинал 	= Объект.Номинал;
		НовыйСертификат.ДатаВыпуска = ТекущаяДата();
		НовыйСертификат.Наименование= СформироватьКодСертификата(); 
		
		НовыйСертификат.Записать();
		
		НовСтр = Объект.Сертификаты.Добавить();
		НовСтр.Номер = НовыйСертификат.Наименование;
		НовСтр.Сертификат = НовыйСертификат.Ссылка;
		
		Сч=Сч+1;
	КонецЦикла;	
КонецПроцедуры	

&НаСервереБезКонтекста
Функция СформироватьКодСертификата() Экспорт

	ГСЧ = Новый ГенераторСлучайныхЧисел();
	
	Префикс = "ПС-" + Формат(ТекущаяДата(), "ДФ=ггММдд") + "-"
             + Формат(ТекущаяДата(), "ДФ=ЧЧммсс") + "-";
    СлучайнаяЧасть = Формат(ГСЧ.СлучайноеЧисло(1000, 9999), "ЧН=4; ЧВН=; ЧГ=0"); 
	
    Возврат Префикс + СлучайнаяЧасть;  
	
КонецФункции 

&НаКлиенте
Процедура ЗапросНаГенерациюСертификатов(Команда)
	ЗапросНаГенерациюСертификатовНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗапросНаГенерациюСертификатовНаСервере() 
	
	RMQ_Очередь = Справочники.ФПВ_RMQ_Очередь.НайтиПоНаименованию("Запрос на создание сертификатов");
	Если Не ЗначениеЗаполнено(Объект.UUIDЗапроса) Тогда
		Объект.UUIDЗапроса = Новый УникальныйИдентификатор;
	КонецЕсли;	
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("UUIDЗапроса",Объект.UUIDЗапроса); 
	СтруктураЗапроса.Вставить("Дата",Объект.Дата);
	СтруктураЗапроса.Вставить("Количество",Объект.Количество);
	СтруктураЗапроса.Вставить("СрокДействия",Объект.СрокДействия);
	СтруктураЗапроса.Вставить("НоминалСумма",Объект.Номинал.Сумма);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(); 
	ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Попытка
		ФПВ_Сертификаты.ОтправитьСообщениеСервер(RMQ_Очередь,СтрокаJSON);
        ЭтаФорма.Записать(); 
		Сообщить("Запрос на генерацию сертификатов успешно отправлен");
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьСгенерированныеСертификаты(Команда)
	ОтправитьСгенерированныеСертификатыНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтправитьСгенерированныеСертификатыНаСервере()
	RMQ_Очередь = Справочники.ФПВ_RMQ_Очередь.НайтиПоНаименованию("Список созданных сертификатов");
	Если Не ЗначениеЗаполнено(Объект.UUIDЗапроса) Тогда
		Объект.UUIDЗапроса = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("UUIDЗапроса",Объект.UUIDЗапроса); 
	СтруктураЗапроса.Вставить("Дата",Объект.Дата);
	СтруктураЗапроса.Вставить("Количество",Объект.Количество);
	СтруктураЗапроса.Вставить("СрокДействия",Объект.СрокДействия);
	СтруктураЗапроса.Вставить("НоминалСумма",Объект.Номинал.Сумма); 
	
	МассивСертификатов = Новый Массив;
	Для Каждого Стр Из Объект.Сертификаты Цикл
		СтруктураСертификата = Новый Структура; 
		СтруктураСертификата.Вставить("Наименование",Стр.Номер);
		СтруктураСертификата.Вставить("ДатаВыпуска",Стр.Сертификат.ДатаВыпуска);
		МассивСертификатов.Добавить(СтруктураСертификата);
	КонецЦикла;
	СтруктураЗапроса.Вставить("МассивСертификатов",МассивСертификатов);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(); 
	ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Попытка
		ФПВ_Сертификаты.ОтправитьСообщениеСервер(RMQ_Очередь,СтрокаJSON);
        ЭтаФорма.Записать();
		Сообщить("Сертефикаты успешно отправлены");
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
	
КонецПроцедуры
