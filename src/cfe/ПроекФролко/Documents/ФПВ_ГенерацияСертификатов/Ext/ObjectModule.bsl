
Процедура ОбработкаПроведения(Отказ, Режим)
	
	КлючевыеОперации = Новый Массив();
	КлючеваяОперация = Новый Структура("ИмяКлючевойОперации, ЦелевоеВремя");
	КлючеваяОперация.ИмяКлючевойОперации = "Документ_ГенерацияСертификата_Проведение";
	КлючеваяОперация.ЦелевоеВремя = 2; // секунд, согласовать с бизнесом
	КлючевыеОперации.Добавить(КлючеваяОперация);
	ОценкаПроизводительности.СоздатьКлючевыеОперации(КлючевыеОперации);
	
	ВремяНачала = ОценкаПроизводительности.НачатьЗамерВремени();
    
	//Если Статус <> Перечисления.СтатусОбработки.Выполнен Тогда
	//    Отказ = Истина;
	//    Сообщить("Проведение возможно только для выполненного документа");
	//    Возврат;
	//КонецЕсли;
    
    Если Сертификаты.Количество() <> Количество Тогда
        Отказ = Истина;
        Сообщить("Количество строк ТЧ не совпадает с реквизитом Количество");
        Возврат;
    КонецЕсли;
	
	// регистр ФПВ_СтатусыСертификатов 
	Движения.ФПВ_СтатусыСертификатов.Записывать = Истина;
	Для Каждого ТекСтрокаСертификаты Из Сертификаты Цикл
		Движение = Движения.ФПВ_СтатусыСертификатов.Добавить();
		Движение.Период 		= Дата;
		Движение.Сертификат 	= ТекСтрокаСертификаты.Сертификат;
		Движение.Статус 		= Перечисления.ФПВ_СтатусыСертификатов.Выпущен;
		Движение.Остаток 		= Номинал.Сумма;
		Движение.ДатаИзменения 	= ТекущаяДата();
	КонецЦикла;

	// регистр ФПВ_ОстаткиСертификатов Приход
	Движения.ФПВ_ОстаткиСертификатов.Записывать = Истина;
	Для Каждого ТекСтрокаСертификаты Из Сертификаты Цикл
		Движение = Движения.ФПВ_ОстаткиСертификатов.Добавить();
		Движение.ВидДвижения 	= ВидДвиженияНакопления.Приход;
		Движение.Период 		= Дата;
		Движение.Сертификат 	= ТекСтрокаСертификаты.Сертификат;
		Движение.Сумма 			= Номинал.Сумма;
	КонецЦикла;  
	
	ОценкаПроизводительности.ЗакончитьЗамерВремени(
		"Документ_ГенерацияСертификата_Проведение",
		ВремяНачала,
		Сертификаты.Количество(),
		"Вес по табличной части ""Сертификаты""");

КонецПроцедуры

Процедура СоздатьСертификаты() Экспорт
	Сч=1;
	Пока Сч<=Количество Цикл
		НовыйСертификат = Справочники.ФПВ_Сертификаты.СоздатьЭлемент();
		НовыйСертификат.Номинал 	= Номинал;
		НовыйСертификат.ДатаВыпуска = ТекущаяДата();
		НовыйСертификат.Наименование= СформироватьКодСертификата();
		НовыйСертификат.СрокДействия = СрокДействия;
		
		НовыйСертификат.Записать();
		
		НовСтр = Сертификаты.Добавить();
		НовСтр.Номер = НовыйСертификат.Наименование;
		НовСтр.Сертификат = НовыйСертификат.Ссылка;
		
		Сч=Сч+1;
	КонецЦикла;	
КонецПроцедуры              

Функция СформироватьКодСертификата() Экспорт

	ГСЧ = Новый ГенераторСлучайныхЧисел();
	
	Префикс = "ПС-" + Формат(ТекущаяДата(), "ДФ=ггММдд") + "-"
             + Формат(ТекущаяДата(), "ДФ=ЧЧммсс") + "-";
    СлучайнаяЧасть = Формат(ГСЧ.СлучайноеЧисло(1000, 9999), "ЧН=4; ЧВН=; ЧГ=0"); 
	
    Возврат Префикс + СлучайнаяЧасть;  
	
КонецФункции

Процедура ОтправитьСгенерированныеСертификаты() Экспорт         
	
	RMQ_Очередь = Справочники.ФПВ_RMQ_Очередь.НайтиПоНаименованию("Список созданных сертификатов");
	Если Не ЗначениеЗаполнено(UUIDЗапроса) Тогда
		UUIDЗапроса = Новый УникальныйИдентификатор;
	КонецЕсли;
	
	СтруктураЗапроса = Новый Структура;
	СтруктураЗапроса.Вставить("UUIDЗапроса",UUIDЗапроса); 
	СтруктураЗапроса.Вставить("Дата",Дата);
	СтруктураЗапроса.Вставить("Количество",Количество);
	СтруктураЗапроса.Вставить("СрокДействия",СрокДействия);
	СтруктураЗапроса.Вставить("НоминалСумма",Номинал.Сумма); 
	
	МассивСертификатов = Новый Массив;
	Для Каждого Стр Из Сертификаты Цикл
		СтруктураСертификата = Новый Структура; 
		СтруктураСертификата.Вставить("Наименование",Стр.Номер);
		СтруктураСертификата.Вставить("ДатаВыпуска",Стр.Сертификат.ДатаВыпуска);
		МассивСертификатов.Добавить(СтруктураСертификата);
	КонецЦикла;
	СтруктураЗапроса.Вставить("МассивСертификатов",МассивСертификатов);
	
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку(); 
	ЗаписатьJSON(ЗаписьJSON, СтруктураЗапроса);
    СтрокаJSON = ЗаписьJSON.Закрыть();
	
	Попытка
		ФПВ_Сертификаты.ОтправитьСообщениеСервер(RMQ_Очередь,СтрокаJSON);
		Сообщить("Сертефикаты успешно отправлены");
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
КонецПроцедуры