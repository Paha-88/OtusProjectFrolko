
Процедура ОбработкаПроведения(Отказ, Режим)
	
	ДанныеСертификата = ФПВ_Сертификаты.ПолучитьДанныеСертификата(Сертификат,,Ссылка);
	Если ДанныеСертификата = Неопределено Тогда
		Отказ = Истина;
		Сообщить("Данный сертификат не выпущен");
		Возврат;
	КонецЕсли;
	
	 
	Если ДанныеСертификата.Статус = Перечисления.ФПВ_СтатусыСертификатов.Погашен 
			ИЛИ ДанныеСертификата.Статус = Перечисления.ФПВ_СтатусыСертификатов.Аннулирован Тогда
		Отказ = Истина;
		Сообщить("Не возможно аннулировать сертификат, не допустимый статус " + ДанныеСертификата.Статус);
		Возврат;
	КонецЕсли;
	
	СтатусСертификата = Перечисления.ФПВ_СтатусыСертификатов.Аннулирован;
	
	// регистр ФПВ_СтатусыСертификатов
	Движения.ФПВ_СтатусыСертификатов.Записывать = Истина;
	Движение = Движения.ФПВ_СтатусыСертификатов.Добавить();
	Движение.Период 		= Дата;
	Движение.Сертификат 	= Сертификат;
	Движение.Статус 		= СтатусСертификата;
	Движение.Остаток 		= 0;
	Движение.ДатаИзменения 	= ТекущаяДата();

	// регистр ФПВ_ОстаткиСертификатов Расход
	Движения.ФПВ_ОстаткиСертификатов.Записывать = Истина;
	Движение = Движения.ФПВ_ОстаткиСертификатов.Добавить();
	Движение.ВидДвижения 	= ВидДвиженияНакопления.Расход;
	Движение.Период 		= Дата;
	Движение.Сертификат 	= Сертификат;
	Движение.Сумма 			= ДанныеСертификата.СуммаОстаток;

КонецПроцедуры
