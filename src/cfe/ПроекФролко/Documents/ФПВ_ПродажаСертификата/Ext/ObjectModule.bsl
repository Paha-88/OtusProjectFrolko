
Процедура ОбработкаПроведения(Отказ, Режим)
	// регистр ФПВ_СтатусыСертификатов  
	
	ДанныеСертификата = ФПВ_Сертификаты.ПолучитьДанныеСертификата(Сертификат,,Ссылка);
	Если ДанныеСертификата = Неопределено Тогда
		Отказ = Истина;
		Сообщить("Данный сертификат не выпущен");
		Возврат;
	КонецЕсли;
	
	Если Не ДанныеСертификата.Статус = Перечисления.ФПВ_СтатусыСертификатов.Выпущен Тогда
		Отказ = Истина;
		Сообщить("Данный сертификат уже активирован");
		Возврат;
	КонецЕсли;
	
	Движения.ФПВ_СтатусыСертификатов.Записывать = Истина;
	
	Движение = Движения.ФПВ_СтатусыСертификатов.Добавить();
	Движение.Период 		= Дата;
	Движение.Статус 		= Перечисления.ФПВ_СтатусыСертификатов.Активирован;
	Движение.Сертификат 	= Сертификат;
	Движение.Остаток 		= СуммаПродажи;
	Движение.ДатаИзменения 	= ТекущаяДата();
	
	СертификатОбъект = Сертификат.ПолучитьОбъект();
	СертификатОбъект.ДатаАктивации = Дата;
	Попытка
		СертификатОбъект.Записать();
	Исключение
		Отказ = Истина;
		Сообщить(ОписаниеОшибки());
	КонецПопытки;	
	
	
КонецПроцедуры
