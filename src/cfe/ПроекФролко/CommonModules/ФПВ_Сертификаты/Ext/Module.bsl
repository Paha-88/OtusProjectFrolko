
Функция ПолучитьДанныеСертификата(СертификатСсылка,ДатаЗапроса = Неопределено, Регистратор = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ФПВ_СтатусыСертификатовСрезПоследних.Статус КАК Статус,
	               |	ФПВ_ОстаткиСертификатовОстатки.СуммаОстаток КАК СуммаОстаток
	               |ИЗ
	               |	РегистрСведений.ФПВ_СтатусыСертификатов.СрезПоследних(&Дата, Сертификат = &Сертификат и ВЫБОР
	               |			КОГДА &ОтборРегистратор
	               |				ТОГДА НЕ Регистратор = &Регистратор
	               |			ИНАЧЕ Истина
	               |		КОНЕЦ) КАК ФПВ_СтатусыСертификатовСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ФПВ_ОстаткиСертификатов.Остатки(&Дата, Сертификат = &Сертификат) КАК ФПВ_ОстаткиСертификатовОстатки
	               |		ПО ФПВ_СтатусыСертификатовСрезПоследних.Сертификат = ФПВ_ОстаткиСертификатовОстатки.Сертификат"; 
	Запрос.УстановитьПараметр("Сертификат",СертификатСсылка);
	Запрос.УстановитьПараметр("ОтборРегистратор",ЗначениеЗаполнено(Регистратор));
	Запрос.УстановитьПараметр("Регистратор",Регистратор);
	Запрос.УстановитьПараметр("Дата",?(ДатаЗапроса=Неопределено,ТекущаяДата(),ДатаЗапроса));
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	Выборка.Следующий();
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("Статус",Выборка.Статус);
	СтруктураВозврата.Вставить("СуммаОстаток",Выборка.СуммаОстаток);
	
	Возврат СтруктураВозврата;     
	
КонецФункции	

Процедура ОтправитьСообщениеСервер(RMQ_Очередь,ТекстЗапроса) Экспорт
	
	КлиентКомпоненты = ПолучитьКомпонентуСервер();
	ОтправитьСообщениеRMQ(КлиентКомпоненты, RMQ_Очередь, ТекстЗапроса);
	
КонецПроцедуры

Процедура ПрочитатьСообщениеСервер(RMQ_Очередь, ОтветноеСообщение) Экспорт
	
	КлиентКомпоненты = ПолучитьКомпонентуСервер();
	ПрочитатьСообщениеRMQ(КлиентКомпоненты, RMQ_Очередь, ОтветноеСообщение);
	
КонецПроцедуры

Процедура ПрочитатьСообщениеRMQ(КлиентКомпоненты, RMQ_Очередь, ОтветноеСообщение)
	
	Попытка
		КлиентКомпоненты.Connect(
			RMQ_Очередь.Адрес,
			RMQ_Очередь.Порт,
			RMQ_Очередь.Логин,
			RMQ_Очередь.Пароль,
			RMQ_Очередь.ВиртуальныйХост);
		
		ИмяОчереди = RMQ_Очередь.ИмяОчереди;
		
		Попытка
			Потребитель = КлиентКомпоненты.BasicConsume(ИмяОчереди, "", Ложь, Ложь, 0);
			
			ОтветноеСообщение = "";
			Если КлиентКомпоненты.BasicConsumeMessage("", ОтветноеСообщение, 5) Тогда
				КлиентКомпоненты.BasicReject();
				ТекстСообщения = НСтр("ru='Сообщение успешно прочитано!'");
			Иначе
				ТекстСообщения = НСтр("ru='Очередь пустая!'");
			КонецЕсли;
			Сообщить(ТекстСообщения);
			
			КлиентКомпоненты.BasicCancel("");
		Исключение
			ВызватьИсключение КлиентКомпоненты.GetLastError();
		КонецПопытки;
	Исключение
		СистемнаяОшибка = ОписаниеОшибки();
		ТекстСообщения = "Ошибка чтения сообщения!%СистемнаяОшибка%";
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%СистемнаяОшибка%", СистемнаяОшибка);
		ВызватьИсключение ТекстСообщения;
	КонецПопытки;
	
КонецПроцедуры

Функция ПолучитьКомпонентуСервер()
	
	КлиентКомпоненты = Неопределено;
	Если Не ИнициализироватьКомпонентуКлиентСервер(КлиентКомпоненты) Тогда
		
		ПодключитьКомпонентуСервер();
		ИнициализироватьКомпонентуКлиентСервер(КлиентКомпоненты);
		
	КонецЕсли;
	
	Возврат КлиентКомпоненты;
КонецФункции 

Процедура ПодключитьКомпонентуСервер(КомпонентаПодключена = Неопределено)
	
	АдресВоВременномХранилище = ПолучитьАдресМакетаКомпановкиНаСервере();
	КомпонентаПодключена = ПодключитьВнешнююКомпоненту(
			АдресВоВременномХранилище,
			"BITERP",
			ТипВнешнейКомпоненты.Native);
	Сообщить(НСтр("ru = 'Компонента подключена!'"));
КонецПроцедуры 

Функция ПолучитьАдресМакетаКомпановкиНаСервере()
	
	МакетВнешнейКомпоненты    = ПолучитьОбщийМакет("ФПВ_ВнешняяКомпонентаRMQ");
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(МакетВнешнейКомпоненты);
	
	Возврат АдресВоВременномХранилище;
	
КонецФункции

Функция ИнициализироватьКомпонентуКлиентСервер(Компонента)
	
	Попытка
		Компонента  = Новый("AddIn.BITERP.PinkRabbitMQ");
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции

Процедура ОтправитьСообщениеRMQ(КлиентКомпоненты, RMQ_Очередь, ТекстЗапроса)
	
	Попытка
		КлиентКомпоненты.Connect(
			RMQ_Очередь.Адрес,
			RMQ_Очередь.Порт,
			RMQ_Очередь.Логин,
			RMQ_Очередь.Пароль,
			RMQ_Очередь.ВиртуальныйХост);
		
		ТочкаОбмена    = RMQ_Очередь.ТочкаОбмена;
		ИмяОчереди     = RMQ_Очередь.ИмяОчереди;
		КлючМаршрутизации = СокрЛП(RMQ_Очередь.КлючМаршрутизации);
		Если ПустаяСтрока(КлючМаршрутизации) Тогда
			КлючМаршрутизации = СокрЛП(ИмяОчереди);
		КонецЕсли;
		
		КлиентКомпоненты.BasicPublish(
			ТочкаОбмена,
			КлючМаршрутизации,
			ТекстЗапроса,
			1,
			Ложь);
	Исключение
		ВызватьИсключение ТекстОшибкиКомпоненты(КлиентКомпоненты, "Ошибка отправки сообщения!", ОписаниеОшибки());
	КонецПопытки;
	
	//Сообщить("Сообщение успешно отправлено!");
КонецПроцедуры   

Функция ТекстОшибкиКомпоненты(КлиентКомпоненты, Заголовок, СистемнаяОшибка)
	
	ТекстОшибкиБрокера = "";
	Попытка
		ТекстОшибкиБрокера = КлиентКомпоненты.GetLastError();
	Исключение
		ТекстОшибкиБрокера = "";
	КонецПопытки;
	
	ТекстСообщения = Заголовок + Символы.ПС + СистемнаяОшибка;
	Если ЗначениеЗаполнено(ТекстОшибкиБрокера)
		И СтрНайти(СистемнаяОшибка, ТекстОшибкиБрокера) = 0 Тогда
		ТекстСообщения = ТекстСообщения + Символы.ПС + ТекстОшибкиБрокера;
	КонецЕсли;
	
	Возврат ТекстСообщения;
	
КонецФункции
